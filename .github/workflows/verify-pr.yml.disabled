name: Verify PR

on:
  pull_request:
    branches:
      - main
    types:
      - opened
      - synchronize
      - reopened
      - ready_for_review
  push:
    branches:
      - main
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  pull-requests: read

jobs:
  verify:
    name: Verify
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          fetch-depth: 0

      - name: Setup mise
        uses: jdx/mise-action@5228313ee0372e111a38da051671ca30fc5a96db # v3

      # The runner's own deps too: lib/hosts/omp-socket.test.mjs checks the host against runner/src/channel.ts.
      - name: Install dependencies
        run: |
          bun install --frozen-lockfile
          bun runner/scripts/use-omp-build.ts
          bun install --cwd runner --frozen-lockfile

      - name: Bun formatting check
        run: bun run format:check

      - name: TypeScript typecheck
        run: bun run typecheck

      - name: Run unit & integration test suite
        run: bun run test

      - name: Verify production build
        run: bun run build

      - name: Build the omp runner
        run: bun runner/scripts/build-binary.ts

      - name: Smoke test
        run: bun run smoke

      # The release binary for this runner (the -baseline x64 build releases ship), from the client built above, with its
      # own `keylime host` daemon (scripts/build-binary.ts).
      - name: Binary smoke test
        shell: bash
        run: |
          bun scripts/build-binary.ts --target bun-linux-x64-baseline
          bin=release/keylime-linux-x64/keylime
          bun run smoke --binary "$bin"

      - name: Packed install smoke test
        shell: bash
        run: |
          bun pm pack --ignore-scripts
          mkdir -p "$RUNNER_TEMP/keylime-package"
          (cd "$RUNNER_TEMP/keylime-package" && bun add "$GITHUB_WORKSPACE"/mcowger-keylime-*.tgz)
          bun run smoke --omp "$(ls runner/release/keylime-omp-*)" --package "$RUNNER_TEMP/keylime-package/node_modules/@mcowger/keylime"

  pr-rules:
    name: PR Rules & Quality Gates
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          fetch-depth: 0

      - name: Verify no forbidden secret or temporary files committed
        run: |
          FORBIDDEN_FILES=$(git diff --name-only origin/main...HEAD | grep -E '(\.env(\..+)?|\.pem|\.key|\.pfx|\.p12|\.DS_Store|thumbs\.db)$' || true)
          if [ -n "$FORBIDDEN_FILES" ]; then
            echo "::error::Forbidden secret or OS temporary files detected in commit:"
            echo "$FORBIDDEN_FILES"
            exit 1
          fi

      - name: Validate PR Title convention
        env:
          PR_TITLE: ${{ github.event.pull_request.title }}
        run: |
          if ! echo "$PR_TITLE" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_-]+\))?: .+'; then
            echo "::warning::PR title does not match Conventional Commits format (e.g. feat(scope): description): $PR_TITLE"
          fi
