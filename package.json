{
  "name": "@mcowger/keylime",
  "version": "0.7.0",
  "description": "Web UI for the oh-my-pi (omp) coding agent",
  "homepage": "https://github.com/mcowger/keylime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcowger/keylime.git"
  },
  "bugs": {
    "url": "https://github.com/mcowger/keylime/issues"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "keylime": "bin/keylime.ts",
    "keylime-launchd": "bin/keylime-launchd.ts",
    "keylime-systemd": "bin/keylime-systemd.ts"
  },
  "files": [
    "bin",
    "lib",
    "app/api",
    "app/fonts/*-OFL.txt",
    "app/fonts/*-LICENSE.*",
    "server",
    "dist",
    "docs/api",
    "public",
    "scripts",
    "proxy.ts",
    "instrumentation.node.ts",
    "tsconfig.json",
    "package.json"
  ],
  "scripts": {
    "dev": "bun --no-env-file scripts/dev.ts",
    "deploy:local": "bun --no-env-file scripts/deploy-local.ts",
    "deploy:local:fast": "bun --no-env-file scripts/deploy-local.ts --timeout 10",
    "deploy:local:fast:follow": "bun --no-env-file scripts/deploy-local.ts --timeout 10 --follow",
    "deploy:local:frontend": "bun --no-env-file scripts/deploy-local.ts --frontend",
    "build": "bun scripts/build-client.ts",
    "build:binary": "bun run build && bun scripts/build-binary.ts",
    "start": "bun server/main.ts -H 127.0.0.1 -p 30177",
    "start:lan": "bun server/main.ts -H 0.0.0.0 -p 30177",
    "test": "bun test --parallel --timeout 30000 ./app ./bin ./components ./hooks ./lib ./scripts ./server ./tests",
    "test:basic": "bun test --parallel --timeout 30000 server/routes.test.ts server/http.test.ts lib/web-auth.test.ts lib/session-reader.test.ts",
    "typecheck": "bun check && bun check -p runner",
    "api:generate": "bun scripts/generate-api-docs.ts",
    "api:check": "bun scripts/generate-api-docs.ts --check",
    "api:bootstrap": "bun scripts/bootstrap-api-schema.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "systemd:install": "bun bin/keylime-systemd.ts install",
    "systemd:uninstall": "bun bin/keylime-systemd.ts uninstall",
    "systemd:start": "bun bin/keylime-systemd.ts start",
    "systemd:stop": "bun bin/keylime-systemd.ts stop",
    "systemd:status": "bun bin/keylime-systemd.ts status",
    "prepack": "bun run build",
    "smoke": "bun runner/scripts/build-binary.ts && bun scripts/smoke.ts",
    "release:check": "bun run format:check && bun run typecheck && bun run test && bun run build && bun run smoke"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@sinclair/typebox": "0.34.52",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.39.0",
    "mammoth": "^1.12.2",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "^11.17.2",
    "micromark-util-character": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "web-push": "^3.6.7",
    "yaml": "^2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@asyncapi/parser": "3.6.6",
    "@sinclair/typebox-codegen": "0.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "1.4.4",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/web-push": "^3.6.4",
    "ajv": "8.20.0",
    "bun-plugin-tailwind": "0.1.2",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.2",
    "micromark-util-types": "^2.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
}
