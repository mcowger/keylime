    "schemas": {
      "TerminalAttachDetach": {
        "description": "Close this attachment without ending the session.",
        "properties": {
          "type": {
            "const": "detach",
            "type": "string"
          }
        },
        "required": ["type"],
        "title": "TerminalAttachDetach",
        "type": "object"
      },
      "TerminalAttachError": {
        "description": "The attachment failed and cannot continue.",
        "properties": {
          "message": {
            "maxLength": 4096,
            "type": "string"
          },
          "type": {
            "const": "error",
            "type": "string"
          }
        },
        "required": ["type", "message"],
        "title": "TerminalAttachError",
        "type": "object"
      },
      "TerminalAttachExit": {
        "description": "The attached terminal process exited.",
        "properties": {
          "code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "const": "exit",
            "type": "string"
          }
        },
        "required": ["type", "code"],
        "title": "TerminalAttachExit",
        "type": "object"
      },
      "TerminalAttachHello": {
        "description": "Start an attachment with the protocol version and terminal dimensions.",
        "properties": {
          "cols": {
            "maximum": 1000,
            "minimum": 2,
            "type": "integer"
          },
          "rows": {
            "maximum": 1000,
            "minimum": 2,
            "type": "integer"
          },
          "type": {
            "const": "hello",
            "type": "string"
          },
          "version": {
            "const": 1,
            "type": "number"
          }
        },
        "required": ["type", "version", "cols", "rows"],
        "title": "TerminalAttachHello",
        "type": "object"
      },
      "TerminalAttachInput": {
        "description": "Send terminal input once on this connection; it is never replayed.",
        "properties": {
          "data": {
            "maxLength": 65536,
            "type": "string"
          },
          "type": {
            "const": "input",
            "type": "string"
          }
        },
        "required": ["type", "data"],
        "title": "TerminalAttachInput",
        "type": "object"
      },
      "TerminalAttachNotice": {
        "description": "An attachment-specific informational notice.",
        "properties": {
          "message": {
            "maxLength": 4096,
            "type": "string"
          },
          "type": {
            "const": "notice",
            "type": "string"
          }
        },
        "required": ["type", "message"],
        "title": "TerminalAttachNotice",
        "type": "object"
      },
      "TerminalAttachOutput": {
        "description": "Terminal output after the snapshot boundary.",
        "properties": {
          "cursor": {
            "minimum": 0,
            "type": "integer"
          },
          "data": {
            "maxLength": 262144,
            "type": "string"
          },
          "type": {
            "const": "output",
            "type": "string"
          }
        },
        "required": ["type", "data", "cursor"],
        "title": "TerminalAttachOutput",
        "type": "object"
      },
      "TerminalAttachResize": {
        "description": "Resize the attached terminal.",
        "properties": {
          "cols": {
            "maximum": 1000,
            "minimum": 2,
            "type": "integer"
          },
          "rows": {
            "maximum": 1000,
            "minimum": 2,
            "type": "integer"
          },
          "type": {
            "const": "resize",
            "type": "string"
          }
        },
        "required": ["type", "cols", "rows"],
        "title": "TerminalAttachResize",
        "type": "object"
      },
      "TerminalAttachSnapshot": {
        "description": "Initial serialized terminal screen and output cursor.",
        "properties": {
          "cols": {
            "maximum": 1000,
            "minimum": 2,
            "type": "integer"
          },
          "cursor": {
            "minimum": 0,
            "type": "integer"
          },
          "data": {
            "maxLength": 4000000,
            "type": "string"
          },
          "rows": {
            "maximum": 1000,
            "minimum": 2,
            "type": "integer"
          },
          "type": {
            "const": "snapshot",
            "type": "string"
          }
        },
        "required": ["type", "data", "cols", "rows", "cursor"],
        "title": "TerminalAttachSnapshot",
        "type": "object"
      }
    },
    "securitySchemes": {
      "webSession": {
        "description": "Optional configured web authentication. Open deployments require no cookie; trusted proxies can authenticate the upgrade. Origin checks still apply.",
        "in": "cookie",
        "name": "keylime_session",
        "type": "httpApiKey"
      }
    }
  },
  "defaultContentType": "application/json",
  "id": "urn:keylime:terminal-attach",
  "info": {
    "description": "Generated from canonical TypeBox schemas, source descriptions and handler annotations. Do not edit; run bun run api.\n\nAuthenticated WebSocket with hostId and sessionId query parameters. The client sends hello first. A snapshot precedes output; input and resize are connection-scoped and never replayed. A new connection obtains a fresh snapshot. Slow clients or disconnected host links are closed.",
    "title": "Session terminal attachment",
    "version": "1"
  },
  "operations": {
    "receive": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/link"
      },
      "messages": [
