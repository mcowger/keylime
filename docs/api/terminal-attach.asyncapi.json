        "payload": {
          "$ref": "#/components/schemas/TerminalAttachHello"
        },
        "title": "TerminalAttachHello"
      },
      "TerminalAttachInput": {
        "contentType": "application/json",
        "description": "Send terminal input once on this connection; it is never replayed.",
        "name": "TerminalAttachInput",
        "payload": {
          "$ref": "#/components/schemas/TerminalAttachInput"
        },
        "title": "TerminalAttachInput"
      },
      "TerminalAttachNotice": {
