        },
        {
          "$ref": "#/channels/link/messages/TerminalAttachDetach"
        }
      ],
      "summary": "Application receives Session terminal attachment messages"
    },
    "send": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/link"
      },
      "messages": [
        {
          "$ref": "#/channels/link/messages/TerminalAttachSnapshot"
        },
        {
          "$ref": "#/channels/link/messages/TerminalAttachOutput"
        },
        {
          "$ref": "#/channels/link/messages/TerminalAttachExit"
