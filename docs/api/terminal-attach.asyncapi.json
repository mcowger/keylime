        },
        "title": "TerminalAttachNotice"
      },
      "TerminalAttachOutput": {
        "contentType": "application/json",
        "description": "Terminal output after the snapshot boundary.",
        "name": "TerminalAttachOutput",
        "payload": {
          "$ref": "#/components/schemas/TerminalAttachOutput"
        },
        "title": "TerminalAttachOutput"
      },
      "TerminalAttachResize": {
        "contentType": "application/json",
